   "source": [
    "## 4. Bias Check — Pipeline Recovery Across Full Parameter Space"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "bias-plot",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1950x650 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved results/fig21_bias_check.png\n"
     ]
    }
   ],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "fig.suptitle('Systematic Bias Check — Recovery Rate Across Parameter Space', fontsize=13, fontweight='bold')\n",
    "atm_types = ['earth_like','high_co2','reduced_o2_high_ch4']\n",
    "colors_b = {'earth_like':'#1565C0','high_co2':'#BF360C','reduced_o2_high_ch4':'#2E7D32'}\n",
    "labels_b = {'earth_like':'Earth-like','high_co2':'High CO2','reduced_o2_high_ch4':'Low O2/High CH4'}\n",
    "\n",
    "for ax, atm in zip(axes, atm_types):\n",
    "    pts = {k:v for k,v in bias.items() if v['atm_type']==atm}\n",
    "    cfs_b  = sorted(set(v['cloud_fraction'] for v in pts.values()))\n",
    "    shs_b  = sorted(set(v['scale_height_km'] for v in pts.values()))\n",
    "    \n",
    "    if len(cfs_b) > 1 and len(shs_b) > 1:\n",
    "        grid_b = np.zeros((len(shs_b), len(cfs_b)))\n",
    "        for i, sh in enumerate(shs_b):\n",
    "            for j, cf in enumerate(cfs_b):\n",
    "                key = f\"{atm}__cf{cf:.1f}__sh{sh:.1f}\"\n",
    "                grid_b[i,j] = pts.get(key, {}).get('recovery_rate', 0)\n",
    "        im = ax.imshow(grid_b, aspect='auto', cmap='RdYlGn',\n",
