  {"cell_type":"code","execution_count":null,"id":"setup","metadata":{},"outputs":[],"source":["import sys, os, json\nsys.path.insert(0, os.path.join('..', 'src'))\nos.chdir('..')\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.gridspec as gridspec\nimport csv, warnings\nwarnings.filterwarnings('ignore')\nplt.rcParams.update({'figure.dpi':130,'axes.spines.top':False,'axes.spines.right':False,'font.size':11})\nos.makedirs('results', exist_ok=True)\n\nCOLORS = {'earth_like':'#1565C0','high_co2':'#BF360C','reduced_o2_high_ch4':'#2E7D32','hycean':'#6A1B9A'}\nLABELS = {'earth_like':'Earth-like (O2+H2O)','high_co2':'High CO2 (Venus)','reduced_o2_high_ch4':'Low O2/High CH4','hycean':'Hycean (K2-18b type)'}\nprint('Setup complete.')"]},
  {"cell_type":"code","execution_count":null,"id":"load","metadata":{},"outputs":[],"source":["# Load MC results\ntrials = []\nwith open('results/exp1/summary.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        for k in ['star_teff_k','star_magnitude_j','planet_radius_re','distance_pc',\n                  'equilibrium_temp_k','cloud_fraction','scale_height_km','o2_ch4_ratio',\n                  'n_transits','broadband_snr','noise_floor_ppm','transit_duration_h']:\n            row[k] = float(row[k])\n        for k in ['planet_id','n_transits']:\n            row[k] = int(float(row[k]))\n        for k in ['in_habitable_zone','is_detected']:\n            row[k] = row[k] in ('True','1','true')\n        trials.append(row)\n\nprint(f'Loaded {len(trials)} trials')\natm_types = ['earth_like','high_co2','reduced_o2_high_ch4','hycean']\nn_transits_vals = sorted(set(t['n_transits'] for t in trials))\nprint(f'N_transits values: {n_transits_vals}')\nprint(f'Distance range: {min(t[\"distance_pc\"] for t in trials):.1f}–{max(t[\"distance_pc\"] for t in trials):.1f} pc')\n\ndef filt(atm=None, n_t=None, hz=None, d_max=None, detected=None):\n    out = trials\n    if atm:      out = [t for t in out if t['atmosphere_type']==atm]\n    if n_t:      out = [t for t in out if t['n_transits']==n_t]\n    if hz is not None: out = [t for t in out if t['in_habitable_zone']==hz]\n    if d_max:    out = [t for t in out if t['distance_pc']<=d_max]\n    if detected is not None: out = [t for t in out if t['is_detected']==detected]\n    return out"]},
  {"cell_type":"markdown","id":"fig1h","metadata":{},"source":["## 1. Detection Probability vs. Distance"]},
  {"cell_type":"code","execution_count":null,"id":"det-vs-dist","metadata":{},"outputs":[],"source":["fig, axes = plt.subplots(1, 2, figsize=(14, 6))\nfig.suptitle('Detection Probability vs. Distance — JWST NIRSpec, 10 Transits', fontsize=13, fontweight='bold')\n\ndist_bins = np.arange(0, 52, 5)\ndist_centers = (dist_bins[:-1] + dist_bins[1:]) / 2\n\nfor ax_i, (ax, title, hz_filter) in enumerate([\n    (axes[0], 'All planets', None),\n    (axes[1], 'Habitable zone only', True),\n]):\n    for atm in atm_types:\n        det_probs = []\n        for i in range(len(dist_bins)-1):\n            lo, hi = dist_bins[i], dist_bins[i+1]\n            pool = [t for t in trials if t['atmosphere_type']==atm\n                    and t['n_transits']==10\n                    and lo <= t['distance_pc'] < hi]\n            if hz_filter is not None:\n                pool = [t for t in pool if t['in_habitable_zone']==hz_filter]\n            if len(pool) >= 3:\n                det_probs.append(sum(t['is_detected'] for t in pool)/len(pool))\n            else:\n                det_probs.append(np.nan)\n        ax.plot(dist_centers, det_probs, 'o-', color=COLORS[atm], lw=2, ms=6, label=LABELS[atm])\n    \n    ax.axhline(0.5, color='gray', lw=1, ls='--', alpha=0.5, label='50% threshold')\n    ax.set_xlabel('Distance (pc)'); ax.set_ylabel('Detection probability')\n    ax.set_title(title); ax.set_xlim(0,51); ax.set_ylim(-0.05,1.05)\n    ax.legend(fontsize=8)\n    # Add calibration note\n    ax.text(0.98, 0.05, 'Note: SNRs pre-calibration\\n(see instrument_validation.ipynb)',\n            transform=ax.transAxes, fontsize=7.5, ha='right', color='gray',\n            bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.7))\n\nplt.tight_layout()\nplt.savefig('results/fig15_det_prob_vs_distance.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint('Saved results/fig15_det_prob_vs_distance.png')"]},
  {"cell_type":"markdown","id":"fig2h","metadata":{},"source":["## 2. Detection Probability vs. Planet Radius & Star Type"]},
  {"cell_type":"code","execution_count":null,"id":"det-vs-radius","metadata":{},"outputs":[],"source":["fig, axes = plt.subplots(1, 3, figsize=(15, 5))\nfig.suptitle('Detection Probability by Planet and Star Properties (N=10 transits)', fontsize=13, fontweight='bold')\n\n# Panel 1: vs planet radius\nax = axes[0]\nrad_bins = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.5]\nrad_centers = [(rad_bins[i]+rad_bins[i+1])/2 for i in range(len(rad_bins)-1)]\nfor atm in ['earth_like','high_co2','hycean']:\n    det_probs = []\n    for i in range(len(rad_bins)-1):\n        lo, hi = rad_bins[i], rad_bins[i+1]\n        pool = [t for t in trials if t['atmosphere_type']==atm and t['n_transits']==10\n                and lo <= t['planet_radius_re'] < hi]\n        det_probs.append(sum(t['is_detected'] for t in pool)/max(len(pool),1) if pool else np.nan)\n    ax.plot(rad_centers, det_probs, 'o-', color=COLORS[atm], lw=2, ms=6, label=LABELS[atm])\nax.axvline(1.7, color='orange', lw=1.5, ls='--', alpha=0.7, label='Fulton gap')\nax.set_xlabel('Planet Radius (R_Earth)'); ax.set_ylabel('Detection probability')\nax.set_title('vs. Planet radius'); ax.legend(fontsize=8); ax.set_ylim(-0.05,1.05)\n\n# Panel 2: vs star type\nax2 = axes[1]\nstar_types = ['M','K','G']\nstar_x = np.arange(len(star_types))\nfor j, atm in enumerate(['earth_like','high_co2','reduced_o2_high_ch4']):\n    dp = []\n    for st in star_types:\n        pool = [t for t in trials if t['atmosphere_type']==atm and t['n_transits']==10\n                and t['star_type']==st]\n        dp.append(sum(t['is_detected'] for t in pool)/max(len(pool),1) if pool else 0)\n    ax2.bar(star_x + j*0.28 - 0.28, dp, 0.26, color=COLORS[atm], alpha=0.85,\n            label=LABELS[atm][:12], edgecolor='black', lw=0.5)\nax2.set_xticks(star_x); ax2.set_xticklabels(star_types)\nax2.set_xlabel('Host Star Type'); ax2.set_ylabel('Detection probability')\nax2.set_title('vs. Star type'); ax2.legend(fontsize=7); ax2.set_ylim(0,1.1)\n\n# Panel 3: SNR violin plot by atmosphere type (10 transits)\nax3 = axes[2]\ndata_for_violin = []\nlabels_v = []\nfor atm in atm_types:\n    snrs = [t['broadband_snr'] for t in trials if t['atmosphere_type']==atm\n            and t['n_transits']==10 and t['broadband_snr'] < 500]\n    if snrs:\n        data_for_violin.append(snrs)\n        labels_v.append(LABELS[atm][:12])\nvp = ax3.violinplot(data_for_violin, positions=range(len(data_for_violin)),\n                     showmedians=True, showextrema=False)\nfor i, (body, atm) in enumerate(zip(vp['bodies'], atm_types)):\n    body.set_facecolor(COLORS[atm]); body.set_alpha(0.7)\nvp['cmedians'].set_color('black'); vp['cmedians'].set_linewidth(2)\nax3.set_xticks(range(len(labels_v))); ax3.set_xticklabels(labels_v, rotation=20, fontsize=9)\nax3.set_ylabel('Corrected broadband SNR (σ)'); ax3.set_title('SNR distribution by\\natmosphere type')\nax3.axhline(5.0, color='red', lw=1.2, ls='--', label='5σ threshold')\nax3.legend(fontsize=8)\n\nplt.tight_layout()\nplt.savefig('results/fig16_det_by_properties.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint('Saved results/fig16_det_by_properties.png')"]},
  {"cell_type":"markdown","id":"fig3h","metadata":{},"source":["## 3. N-Transits to Detection — Integration Time Budget"]},
  {"cell_type":"code","execution_count":null,"id":"ntransits","metadata":{},"outputs":[],"source":["fig, axes = plt.subplots(1, 2, figsize=(13, 5))\nfig.suptitle('Integration Time to Detection — HZ Rocky Planets', fontsize=13, fontweight='bold')\n\n# Panel 1: Detection probability vs n_transits\nax = axes[0]\nhz_rocky = [t for t in trials if t['in_habitable_zone'] and t['planet_radius_re'] < 1.7]\nfor atm in atm_types:\n    det_by_nt = []\n    for n_t in n_transits_vals:\n        pool = [t for t in hz_rocky if t['atmosphere_type']==atm and t['n_transits']==n_t]\n        det_by_nt.append(sum(t['is_detected'] for t in pool)/max(len(pool),1) if pool else 0)\n    ax.plot(n_transits_vals, det_by_nt, 'o-', color=COLORS[atm], lw=2.5, ms=8, label=LABELS[atm])\nax.axhline(0.8, color='gray', lw=1, ls=':', alpha=0.7, label='80% completeness')\nax.set_xlabel('Number of transits observed')\nax.set_ylabel('Detection probability')\nax.set_title('HZ rocky planets (Rp < 1.7 Re), all distances')\nax.set_xticks(n_transits_vals); ax.legend(fontsize=9); ax.set_ylim(-0.05,1.05)\n\n# Panel 2: Implied total observing hours vs distance\nax2 = axes[1]\ndist_arr = np.array([5,10,15,20,30,40,50])\n# Assume typical M-dwarf HZ period ~10 days, transit duration ~1.5h\nobs_hours = dist_arr * 0  # placeholder\nfor n_t in [5,10,20]:\n    # Total time = n_transits * transit_duration * period_per_year factor\n    # Rough: 1.5h per transit * n_t transits\n    total_h = n_t * 1.5  # hours in-transit (rough; ignores out-of-transit)\n    ax2.axhline(total_h, lw=1.5, ls='--', label=f'N={n_t} transits ({total_h:.0f}h in-transit)')\nax2.fill_between([0,52],[0,0],[20,20], alpha=0.08, color='green', label='JWST cycle 1 GO typical')\nax2.set_xlabel('Distance (pc)')\nax2.set_ylabel('Total in-transit time (hours)')\nax2.set_title('Integration time budget')\nax2.set_xlim(0,52); ax2.set_ylim(0,35)\nax2.legend(fontsize=9)\n\nplt.tight_layout()\nplt.savefig('results/fig17_ntransits_budget.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint('Saved results/fig17_ntransits_budget.png')"]},
