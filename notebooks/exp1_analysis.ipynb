  {"cell_type":"code","execution_count":null,"id":"headline-cell","metadata":{},"outputs":[],"source":["print('='*60)\nprint('HEADLINE RESULTS — Exp 1 (pre-calibration; see note below)')\nprint('='*60)\n\nfor n_t in n_transits_vals:\n    print(f'\\n  N_transits = {n_t}:')\n    for atm in atm_types:\n        hz = [t for t in trials if t['atmosphere_type']==atm and t['n_transits']==n_t\n              and t['in_habitable_zone'] and t['planet_radius_re'] < 1.7]\n        d20 = [t for t in hz if t['distance_pc'] <= 20]\n        hz_rate  = sum(t['is_detected'] for t in hz)/max(len(hz),1)\n        d20_rate = sum(t['is_detected'] for t in d20)/max(len(d20),1)\n        snrs = [t['broadband_snr'] for t in trials if t['atmosphere_type']==atm and t['n_transits']==n_t]\n        print(f'    {atm:28s}  HZ={hz_rate:.0%}  d<20pc={d20_rate:.0%}  '\n              f'N_HZ={len(hz)}  med_SNR={np.median(snrs):.0f}σ')\n\nprint()\nprint('CALIBRATION NOTE:')\nprint('  Quoted SNRs use corrected (modulation-only) metric.')\nprint('  However, blackbody photon rate overestimates real M-dwarf flux')\nprint('  by ~2-3x at lambda>2um. After applying ETC calibration factors:')\nprint('  - Detection rates at d<20pc: earth_like ~70-85% (not 97%)')\nprint('  - Hycean worlds remain ~100% detectable (large scale height)')\nprint('  - See instrument_validation.ipynb for full calibration derivation.')\nprint('  Calibrated numbers will be used in all paper figures.')"]},
